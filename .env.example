# Copy to .env for local use, or set these in Coolify's Environment Variables UI.
# Never commit the real .env file.

# ── Firefly III ──────────────────────────────────────────────────────────────
# MUST be exactly 32 characters. Generate with:  openssl rand -hex 16
APP_KEY=

# Public URL of Firefly III (the domain you assign in Coolify)
APP_URL=https://finance.example.com

SITE_OWNER=you@example.com
TZ=Europe/London
DEFAULT_LANGUAGE=en_GB

# ── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=firefly
DB_USERNAME=firefly
# Generate with:  openssl rand -hex 24
DB_PASSWORD=

# ── Cron ─────────────────────────────────────────────────────────────────────
# MUST be exactly 32 characters. Generate with:  openssl rand -hex 16
STATIC_CRON_TOKEN=

# ── Data Importer ────────────────────────────────────────────────────────────
# Personal Access Token: create in Firefly III under Profile -> OAuth ->
# Personal Access Tokens, after your first login. Leave empty on first deploy.
FIREFLY_III_ACCESS_TOKEN=

# GoCardless Bank Account Data (free tier): https://bankaccountdata.gocardless.com
# Create a "user secret" there; ID goes in NORDIGEN_ID, key in NORDIGEN_KEY.
NORDIGEN_ID=
NORDIGEN_KEY=

# ── Optional: scheduled/automatic imports ────────────────────────────────────
# Set a secret and flip the flags to true to enable the importer's
# /autoupload and /autoimport endpoints (see README, "Automating imports").
AUTO_IMPORT_SECRET=
CAN_POST_AUTOIMPORT=false
CAN_POST_FILES=false
