# Copy to .env for local use, or set these in Coolify's Environment Variables UI.
# Never commit the real .env file.

# ── Firefly III ──────────────────────────────────────────────────────────────
# MUST be exactly 32 characters. Generate with:  openssl rand -hex 16
APP_KEY=

# Public URL of Firefly III (the domain you assign in Coolify)
APP_URL=https://finance.example.com

SITE_OWNER=you@example.com
TZ=Europe/London
DEFAULT_LANGUAGE=en_GB

# ── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=firefly
DB_USERNAME=firefly
# Generate with:  openssl rand -hex 24
DB_PASSWORD=

# ── Cron ─────────────────────────────────────────────────────────────────────
# MUST be exactly 32 characters. Generate with:  openssl rand -hex 16
STATIC_CRON_TOKEN=

# ── Data Importer ────────────────────────────────────────────────────────────
# Personal Access Token: create in Firefly III under Profile -> OAuth ->
# Personal Access Tokens, after your first login. Leave empty on first deploy.
FIREFLY_III_ACCESS_TOKEN=

# ── Bank data providers (see README "Linking the banks") ─────────────────────

# Enable Banking (https://enablebanking.com) - free "restricted mode" for your
# own accounts. Create an application in their Control Panel; the Application ID
# goes here and the downloaded PEM private key goes below as ONE line, with \n
# after "-----BEGIN PRIVATE KEY-----" and before "-----END PRIVATE KEY-----":
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----"
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Lunch Flow (https://lunchflow.app) - paid aggregator (~$35/year) that covers
# Monzo (via its GoCardless agreement) and Trading 212 (via SnapTrade).
# Dashboard -> Destinations -> Add Destination -> API -> copy the API key.
LUNCH_FLOW_API_KEY=

# GoCardless Bank Account Data - CLOSED to new registrations since July 2025.
# Only fill these if you already have a working account from before.
NORDIGEN_ID=
NORDIGEN_KEY=

# ── Optional: scheduled/automatic imports ────────────────────────────────────
# Set a secret and flip the flags to true to enable the importer's
# /autoupload and /autoimport endpoints (see README, "Automating imports").
AUTO_IMPORT_SECRET=
CAN_POST_AUTOIMPORT=false
CAN_POST_FILES=false
